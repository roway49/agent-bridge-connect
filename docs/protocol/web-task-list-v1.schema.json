{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentbc:web-task-list:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "catalogue_revision",
    "items",
    "next_cursor"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "catalogue_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "title",
          "executor",
          "status",
          "updated_at",
          "title_truncated",
          "error_code"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[23456789ABCDEFGHJKMNPQRSTVWXYZ]{4,}-[0-9]{3}$"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "executor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "title_truncated": {
            "type": "boolean"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    }
  }
}
