{
  "absent_session_detection": "'session not found' style output maps to already-absent",
  "argv": [
    "sessions",
    "delete",
    "{session_id}",
    "--yes"
  ],
  "entries_that_never_qualify": [
    "--continue",
    "picker",
    "prune",
    "purge",
    "<fuzzy id-or-name selector>"
  ],
  "error_codes": {
    "failed": "hermes_session_delete_failed",
    "invalid_session_id": "hermes_session_delete_invalid_session_id",
    "missing_session_id": "hermes_session_delete_missing_session_id",
    "unsupported": "hermes_session_delete_unavailable"
  },
  "help_entry_captured": true,
  "help_excerpt_ref": "sessions_delete_help.txt",
  "session_id_format_regex": "^\\d{8}_\\d{6}_[0-9a-fA-F]{6,32}$",
  "strategy": "official_session_delete",
  "surface": "session_delete"
}
