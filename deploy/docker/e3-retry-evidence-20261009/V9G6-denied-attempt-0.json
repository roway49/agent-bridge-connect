  "steps": [
    {
      "id": 1,
      "description": "这是AgentBC E3拒绝审批、retry与close的受控验收。在本任务分配的artifact root，用Python创建e3-ready.txt，内容严格为AGENTBC_E3_READY加一个换行，读回验证。遵循真实权限请求，拒绝后不得改用其他工具绕过、不得自行retry或修改权限。获准完成时记录步骤1 authoritative progress。仅操作本任务目录，不联网、不创建子任务、不修改配置。",
      "record": "steps/01.json",
      "status": "blocked"
    },
    {
      "id": 2,
      "description": "用一次前台Python命令等待本任务目录的e3-release.txt，最多900秒、每2秒检查一次。控制器将在此期间验证关闭任务，禁止自行创建release文件、提前完成步骤或输出成功callback，禁止调用任务控制命令。若被终止则停止；若900秒超时则如实报告未完成。只有控制器创建release后才写e3-done.txt，内容AGENTBC_E3_DONE加一个换行，读回验证、记录步骤2并输出真实最终callback。",
      "record": "steps/02.json",
      "status": "pending"
    }
  ],
